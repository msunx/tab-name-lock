{
  "manifest_version": 3,
  "name": "标签定名",
  "version": "1.5.1",
  "description": "独立命名标签页，监听页面元素从状态 A 变为 B，发送系统通知并可同步推送到 Bark。规则与名称关闭即清除。",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "notifications",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "标签定名",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/toolbar/16.png",
      "20": "icons/toolbar/20.png",
      "24": "icons/toolbar/24.png",
      "32": "icons/toolbar/32.png",
      "48": "icons/toolbar/48.png",
      "128": "icons/toolbar/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "给当前标签页定名"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://chromewebstore.google.com/*",
        "https://chrome.google.com/webstore/*"
      ],
      "js": [
        "content.js",
        "monitor-content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "incognito": "split",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
